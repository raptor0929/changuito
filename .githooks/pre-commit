#!/bin/sh
# Blocks a commit that stages a secret. Enabled by `npm install` (the
# `prepare` script sets core.hooksPath=.githooks). Needs gitleaks on PATH:
# https://github.com/gitleaks/gitleaks#installing. CI runs the same scan.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed; skipping the local secret scan (CI still runs it)." >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
