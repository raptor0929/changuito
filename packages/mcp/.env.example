# ---------------------------------------------------------------------------
# supermercado-mcp — configuration
#
# Copy to .env and fill in. Every variable here is read in exactly one place,
# src/config.ts, which validates it and fails at startup rather than halfway
# through a purchase. `npm run build && node dist/index.js` then the `diagnose`
# tool prints what this file resolved to, with no secret values in it.
#
# Nothing below is required for SEARCH. The read-only tools (search_products,
# price_check, view_cart, get_cart_link …) work with an empty file. The
# checkout tools read config lazily, so they are the only ones that complain.
# ---------------------------------------------------------------------------

# --- Store -----------------------------------------------------------------
# dia | carrefour | jumbo | disco. Only `dia` is implemented through checkout;
# the others are search-only and will be refused by the payment tools.
RETAILER=dia

# --- Where secrets live ----------------------------------------------------
# Holds the encrypted session vault and, by default, the wallet keystore.
# Keep it out of version control. Nothing readable is ever written here.
SECRETS_DIR=.secrets
# KEYSTORE_PATH=.secrets/wallet.keystore.json

# Passphrases. These are NOT read from this file by the code — config.ts reads
# them from the environment, and the MCP server has no terminal to prompt on,
# so export them in the shell that launches your MCP client (or put them here
# if your client loads .env, accepting that they then sit on disk in plaintext).
#
#   SESSION_PASSPHRASE  unlocks .secrets/dia.session.enc  (your store cookies)
#   WALLET_PASSPHRASE   unlocks the keystore              (your private key)
#
# Minimum 8 characters, and they are the only thing between those files and
# whoever copies them. Different values for the two. 12+ recommended.
# SESSION_PASSPHRASE=
# WALLET_PASSPHRASE=

# --- Vyrion (the virtual card) ---------------------------------------------
# sk_test_… for sandbox, sk_live_… for real cards. A live key with ALLOW_LIVE
# unset is a startup error, on purpose.
VYRION_API_KEY=sk_test_replace_me
# VYRION_BASE_URL=https://api.vyrioncard.com

# Merchant categories the card may be used at. 5411 grocery, 5499 specialty
# food, 5311 department store. Narrower is safer: a stolen card buys groceries.
ALLOWED_MCC=5411,5499,5311

# The second safety catch on real money. Without this, approve_payment and
# replenish_wallet refuse even with a correct restated amount.
ALLOW_LIVE=0

# --- FX (Día charges ARS, Vyrion funds USD) --------------------------------
# Cards are funded at ceil(total / rate * (1 + buffer)); the spending limit is
# set to exactly that, and the residual returns to your wallet when the card is
# terminated. The buffer is float, not spend — it costs nothing.
FX_BUFFER=0.15
# Pin the rate instead of looking it up. Useful for dry runs and tests.
# ARS_PER_USD=1450

# --- Crypto wallet (top-ups only; never in the checkout path) --------------
# usdt | eth are signable here. btc and sol are accepted by Vyrion but you must
# send those by hand — replenish_wallet will say so rather than pretend.
FUNDING_ASSET=usdt
CHAIN_ID=1
# Needed only to read your balance and broadcast a top-up. Everything else
# works without it.
# RPC_URL=https://mainnet.infura.io/v3/<your-key>
# Defaults are known for chains 1, 137 and 42161. Set this on any other chain.
# USDT_ADDRESS=

# --- Jev / TypeSafe (classifier layer 3) ------------------------------------
# Optional. With JEV_ENABLED=false the navigation loop runs on layers 1, 2 and
# 4 only: strictly less capable (it escalates to you more often), never less
# safe. Jev never sees card data and can never approve an amount.
JEV_ENABLED=false
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
# Below this confidence the loop stops and asks you instead of guessing.
JEV_MIN_CONFIDENCE=0.75

# --- Browser ---------------------------------------------------------------
# Checkout runs headless. The login capture is always headed regardless.
HEADLESS=true
# Hard ceilings on the navigation loop, so a confused page cannot spin forever.
MAX_STEPS=25
MAX_MINUTES=4
# Milliseconds of delay between actions. Useful when watching a run; 0 in use.
SLOWMO_MS=0

# --- Smoke test (read-only, four stores) -----------------------------------
SMOKE_QUERY=leche descremada
SMOKE_POSTAL_CODE=1425
