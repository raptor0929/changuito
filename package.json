{
  "name": "changuito",
  "private": true,
  "version": "0.1.0",
  "description": "An agent that shops Argentine supermarkets over MCP and settles in USDC on Stellar.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @changuito/web",
    "dev:landing": "npm run dev -w @changuito/landing",
    "build": "npm run build -w @changuito/web",
    "build:landing": "npm run build -w @changuito/landing",
    "start": "npm run start -w @changuito/web",
    "test": "npm test -w @changuito/mcp && npm test -w @changuito/trust && npm test -w @changuito/web && npm test -w @changuito/landing",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "contracts:build": "stellar contract build --manifest-path contracts/Cargo.toml",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml",
    "deploy:testnet": "./scripts/deploy-testnet.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  }
}
