# Copy to e2e/.env (gitignored). Do not put real secrets in git.
# Defaults already point at production; override only for a preview deploy.

LANDING_BASE_URL=https://www.changuito.me
APP_BASE_URL=https://app.changuito.me

# Optional. Both must be set or the auth spec skips.
# Pollar email login is a 6-digit code, not a password.
# Put the code in CHANGUTO_E2E_OTP, or in CHANGUTO_E2E_PASSWORD only if it
# is exactly six digits. A normal password still runs the email step and
# stops when the code screen appears. See docs/e2e.md.
CHANGUTO_E2E_EMAIL=
CHANGUTO_E2E_PASSWORD=
CHANGUTO_E2E_OTP=

# The frame-checkout flow (project `checkout`) runs against a server of its
# own, not a deployment: the fixture it frames in the store's place does not
# exist in production. Leave this unset and Playwright starts `next dev` on
# 3124 for you, or reuses one already open.
CHECKOUT_BASE_URL=http://localhost:3124
