{
  "name": "@changuito/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3124",
    "prebuild": "tsc -p ../../packages/mcp",
    "build": "next build",
    "start": "next start -p 3124",
    "typecheck": "tsc --noEmit",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --no-warnings --test \"lib/test/*.test.ts\"",
    "prebuild:vinext": "tsc -p ../../packages/mcp",
    "dev:vinext": "vite dev --port 3124",
    "build:vinext": "vite build",
    "postbuild:vinext": "node ../../scripts/migrate-on-build.mjs",
    "start:vinext": "vinext start",
    "deploy:vinext": "vinext-cloudflare deploy --skip-build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "@cfworker/json-schema": "^4.1.4",
    "@changuito/escrow-bindings": "*",
    "@changuito/mcp": "*",
    "@changuito/usdc-bindings": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@pollar/core": "0.11.3",
    "@pollar/react": "0.11.3",
    "@stellar/stellar-sdk": "17.1.0",
    "@upstash/redis": "^1.39.0",
    "@vinext/cloudflare": "^1.3.2",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "qr.js": "0.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.10",
    "@types/node": "^22.19.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.27",
    "testcontainers": "^11.14.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  },
  "type": "module"
}
