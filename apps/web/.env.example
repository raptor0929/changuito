# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.

# ---- human gate (production) -----------------------------------------------
# Cloudflare Turnstile, widget hostname app.changuito.me, Managed mode.
# Both must be set on the shopper Vercel project (apps/web), Production and
# Preview. The site key is public. The secret stays on the server.
# Missing either one in production closes the gate (chat does not open).
# Local without these stays open so `next dev` still chats.
# A value added in Vercel applies on the next deploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- the agent -------------------------------------------------------------
# console.anthropic.com -> API keys. Server-side only: it is what /api/chat
# uses to run the shopping agent.
ANTHROPIC_API_KEY=

# ---- the wallet ------------------------------------------------------------
# pollar.xyz dashboard -> your application -> API key. Publishable: it ships in
# the browser bundle by design, which is why the name starts with NEXT_PUBLIC_.
# Leave it empty and the app still runs — chat, search and cart all work, and
# the masthead shows "Billetera: sin configurar" instead of a balance.
NEXT_PUBLIC_POLLAR_API_KEY=

# ---- the backend signer ----------------------------------------------------
# The secret for `changuito-resolver`, the key that mints demo USDC for the
# faucet and settles or refunds escrow orders. Print it with:
#
#     stellar keys show changuito-resolver
#
# Server-side only. It is a testnet key holding play money, but it is still a
# secret key: it never gets a NEXT_PUBLIC_ prefix and never reaches the client.
STELLAR_RESOLVER_SECRET=

# ---- conversation history (optional) ---------------------------------------
# Redis, so the agent remembers what you said after the server restarts.
#
# Without it the app still works: history lives in the process, which is
# exactly right for one developer on one machine. On Vercel it is not — a cold
# start, a deploy or a scale-out mid-basket wipes it, and the agent answers
# with no idea what was asked while the page still shows every bubble.
#
# Vercel -> Storage -> Marketplace -> Upstash for Redis. Connecting the project
# injects these automatically, so you only need them here for local dev. Use
# the REST pair, not REDIS_URL or KV_URL: those are rediss:// strings for a TCP
# client, and one connection per lambda is the problem the REST API avoids.
# A database created directly at upstash.com names them UPSTASH_REDIS_REST_URL
# and UPSTASH_REDIS_REST_TOKEN instead; both are read.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- optional ---------------------------------------------------------------
# Pin the ARS/USD rate instead of reading the live feed, so a demo quotes the
# same number every time. Unset means live.
FX_ARS_PER_USD=

# Optional. The agent model. Defaults to claude-sonnet-5. Haiku 4.5 runs (the
# loop switches to a fixed thinking budget for it), but in the one run measured
# here it stopped after the product search without building the cart.
# AGENT_MODEL=claude-haiku-4-5-20251001

# Optional. Logs per-hop token usage to the server console.
# AGENT_USAGE=1

# ---- the local model (optional) --------------------------------------------
# Serve inference from your own machine and keep Anthropic as the fallback.
#
# Entirely optional: unset, the agent uses claude-sonnet-5 and none of this
# code runs. Set, the agent prefers the local model and falls back to Sonnet
# whenever the machine is asleep, busy, slow to start, or out of turn budget.
#
# Server-side only, deliberately un-prefixed. OLLAMA_URL is a hostname that
# reaches a machine of yours, and with OLLAMA_HEADERS it is a credential pair.
# In the browser bundle that is a public key to your laptop.
#
# See DEPLOY.md Part 3 for setting up the machine and the tunnel.

# auto      prefer the local model, fall back to Sonnet. The default when
#           OLLAMA_URL is set, and what a deployment should use.
# anthropic ignore the local model entirely.
# ollama    local only — fails the turn with a visible error instead of
#           falling back. The only way to confirm the machine is really being
#           used, since `auto` succeeds either way by design.
# AGENT_PROVIDER=auto

# The base URL, no trailing slash. A tunnel hostname in production; a Tailscale
# address for local dev. Never a plain LAN IP over the public internet —
# Ollama has no authentication of its own.
# OLLAMA_URL=https://ollama.example.com

# Must already be pulled on that machine; the health probe checks presence, not
# just that the server answers. Defaults to qwen3:8b.
# OLLAMA_MODEL=qwen3:8b

# Extra request headers, as JSON. This is where a Cloudflare Access service
# token goes. Sent with the health probe too — without that, an auth failure
# looks exactly like the machine being down.
# OLLAMA_HEADERS={"CF-Access-Client-Id":"...","CF-Access-Client-Secret":"..."}

# Concurrent local turns. Defaults to 1, which is correct for a 16GB machine:
# it runs one model instance, so raising this buys a queue rather than
# parallelism — and a queued visitor waits behind a stranger's groceries when
# Sonnet would have answered them in a second.
# OLLAMA_LANES=1
