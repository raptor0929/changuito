# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.

# ---- the agent -------------------------------------------------------------
# console.anthropic.com -> API keys. Server-side only: it is what /api/chat
# uses to run the shopping agent.
ANTHROPIC_API_KEY=

# ---- the wallet ------------------------------------------------------------
# pollar.xyz dashboard -> your application -> API key. Publishable: it ships in
# the browser bundle by design, which is why the name starts with NEXT_PUBLIC_.
# Leave it empty and the app still runs — chat, search and cart all work, and
# the masthead shows "Billetera: sin configurar" instead of a balance.
NEXT_PUBLIC_POLLAR_API_KEY=

# ---- the backend signer ----------------------------------------------------
# The secret for `changuito-resolver`, the key that mints demo USDC for the
# faucet and settles or refunds escrow orders. Print it with:
#
#     stellar keys show changuito-resolver
#
# Server-side only. It is a testnet key holding play money, but it is still a
# secret key: it never gets a NEXT_PUBLIC_ prefix and never reaches the client.
STELLAR_RESOLVER_SECRET=
