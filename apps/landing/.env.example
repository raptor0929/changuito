# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.
#
# The landing site renders without any of these. What they buy is the two
# forms: the whitelist signup at /whitelist and the bug report at /reportarbug.

# ---- the CAPTCHA -----------------------------------------------------------
# Cloudflare dashboard -> Turnstile -> add a site. You get a pair: the site key
# is rendered into the widget, the secret verifies the token server-side.
#
# In development, leaving both empty skips the CAPTCHA and logs a one-time
# warning, so the whitelist form works on localhost with no Cloudflare account.
#
# In production they are required. Missing either one makes POST /api/whitelist
# fail every submission with an "unconfigured" error rather than quietly
# accepting unverified signups — see lib/waitlist/turnstile.ts.
#
# /reportarbug does not verify Turnstile; only the whitelist does.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- where whitelist signups go (pick one, or neither) ---------------------
# Signups need somewhere to land. There are two sinks and they are tried in
# order: Redis first, then the webhook. Configuring both means the webhook
# fires as a notification after a successful Redis write, and also acts as the
# fallback if Redis is down.
#
# With neither, a non-production run appends JSON lines to a local file, which
# is the right answer for one developer. In production it refuses the signup
# and logs, rather than telling someone they are on a list that does not exist.

# Redis. Vercel -> Storage -> Marketplace -> Upstash for Redis; connecting the
# project injects these, so you only need them here for local dev. Use the REST
# pair, not REDIS_URL or KV_URL. A database created directly at upstash.com
# names them UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN; both are read.
# The URL must be https — an http one is ignored, not downgraded to.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# A webhook instead of, or alongside, Redis. Zapier, Make, an Apps Script, your
# own endpoint. Must be https, except on localhost/127.0.0.1. An unparseable or
# plain-http URL is ignored silently, so check this if signups stop arriving.
#
# The POST carries an `X-Changuito-Waitlist: 1` header and a JSON body tagged
# `kind: "waitlist"`, which is how a shared endpoint tells signups from bug
# reports. A 2xx is not enough on its own: a response body that says `ok:false`
# counts as a failed signup, because Apps Script answers 200 to everything and
# would otherwise swallow every entry silently.
# WAITLIST_WEBHOOK_URL=https://hooks.example.com/waitlist

# Optional, so your endpoint can reject anything that is not us — anyone who
# learns the URL can post to it otherwise.
#
# Sent twice: as `Authorization: Bearer <secret>` and as `webhookSecret` in the
# JSON body. The body copy is there for Apps Script and anything else behind a
# proxy that drops the Authorization header before the handler sees it. If your
# endpoint can read headers, check the header and ignore the body field.
# WAITLIST_WEBHOOK_SECRET=

# ---- where bug reports go (optional) ---------------------------------------
# Same shape as the whitelist webhook, separate destination: a bug report is
# not a signup and you probably do not want them in the same place.
#
# Unset, a report is written to the server log and the submitter still gets a
# success — the report is not lost, it is just only visible in Vercel's logs.
# Set but unparseable, it logs the mistake explicitly and falls back to the log
# sink rather than dropping the report.
# The POST carries both `X-Changuito-Bug-Report: 1` and `X-Changuito-Bug: 1`.
# The second is what the live Apps Script classifies on — without it a report
# carrying a name, an email and a createdAt lands in the waitlist sheet.
# BUG_REPORT_WEBHOOK_URL=https://hooks.example.com/bugs

# Optional. Sent as `Authorization: Bearer <secret>`. Header only, unlike the
# waitlist one, which also puts it in the body.
# BUG_REPORT_WEBHOOK_SECRET=
